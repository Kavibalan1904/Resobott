{
  "name": "reso-music-bot",
  "version": "2.0.0",
  "description": "Reso — A high-quality Discord music bot powered by Lavalink",
  "main": "index.js",
  "scripts": {
    "start": "node --trace-warnings --optimize_for_size --max-old-space-size=460 index.js",
    "dev": "node --trace-warnings --watch index.js",
    "test": "node --test",
    "avatar:apply": "node animator/animate.js",
    "avatar:rollback": "node animator/rollback.js",
    "commands:clean": "node scripts/clear-guild-commands.js"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "discord",
    "music",
    "bot",
    "reso",
    "lavalink"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "discord.js": "^14.16.3",
    "dotenv": "^16.4.5",
    "genius-lyrics": "^4.4.7",
    "lavalink-client": "^2.4.4"
  },
  "devDependencies": {
    "sharp": "^0.34.5"
  }
}
