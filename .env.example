# Discord Bot Token (Required)
# Get yours at https://discord.com/developers/applications
DISCORD_TOKEN=your_discord_bot_token_here

# Bot Client ID (Required for slash command registration)
CLIENT_ID=your_bot_client_id_here

# Default Volume (0-100, default: 50)
DEFAULT_VOLUME=50

# Genius API Token (Optional — for lyrics)
# Get yours at https://genius.com/api-clients
GENIUS_API_TOKEN=your_genius_api_token_here

# Primary Lavalink node: your Render service
LAVALINK_HOST=lavalink1-7tbh.onrender.com
LAVALINK_PORT=443
# Must exactly match LAVALINK_PASSWORD in the Render Lavalink service.
# Set this to the exact same strong secret configured in the Lavalink Render service.
LAVALINK_PASSWORD=replace_with_a_long_random_secret
LAVALINK_SECURE=true
