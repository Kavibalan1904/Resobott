# Discord Bot Token (Required)
# Get yours at https://discord.com/developers/applications
DISCORD_TOKEN=your_discord_bot_token_here

# Bot Client ID (Required for slash command registration)
CLIENT_ID=your_bot_client_id_here

# Bot Prefix (For text commands)
PREFIX=>

# Default Volume (0-100, default: 50)
DEFAULT_VOLUME=50

# Genius API Token (Optional — for lyrics)
# Get yours at https://genius.com/api-clients
GENIUS_API_TOKEN=your_genius_api_token_here

# Lavalink Node Configuration (Primary: Millohost SSL)
LAVALINK_HOST=lava-v4.millohost.my.id
LAVALINK_PORT=443
LAVALINK_PASSWORD=https://discord.gg/mjS5J2K3ep
LAVALINK_SECURE=true

# ── AI Music DJ Configuration (Optional) ────────────────────────
# AI is optional. If AI_API_KEY (or GEMINI_API_KEY) is omitted, the DJ operates automatically
# using Reso's built-in offline rules and deterministic matching engine.
#
# Supported providers: "gemini" (default) or "openai" (works with Groq, OpenRouter, Ollama)
AI_PROVIDER=gemini
AI_API_KEY=your_gemini_or_openai_api_key_here
# GEMINI_API_KEY=your_gemini_api_key_here # Alias: GEMINI_API_KEY also works directly!
AI_MODEL=gemini-3.8-flash
# AI_BASE_URL=https://api.openai.com/v1 # Only needed for custom OpenAI endpoints/Groq/Ollama
