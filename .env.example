# Discord Bot Token (Required)
# Get yours at https://discord.com/developers/applications
DISCORD_TOKEN=your_discord_bot_token_here

# Bot Client ID (Required for slash command registration)
CLIENT_ID=your_bot_client_id_here

# Default Volume (0-100, default: 50)
DEFAULT_VOLUME=50

# Genius API Token (Optional — for lyrics)
# Get yours at https://genius.com/api-clients
GENIUS_API_TOKEN=your_genius_api_token_here

# Lavalink Node Configuration (Primary: Millohost SSL)
LAVALINK_HOST=lava-v4.millohost.my.id
LAVALINK_PORT=443
LAVALINK_PASSWORD=https://discord.gg/mjS5J2K3ep
LAVALINK_SECURE=true
